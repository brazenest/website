---
/**
 * HOME (v7) — the site is a conversation.
 *
 * A visitor asks; the chat Worker (chat-worker/) answers from the site's own published
 * content and links the real pages as it goes. The rest of the site stays as plain pages to
 * land on, and this page still server-renders a headline, an intro and a link to every
 * section, so crawlers and no-JS visitors get a working home page.
 *
 * Colour: the page starts in the house grey; src/scripts/chat.ts moves <html data-work> to
 * whichever venture the latest answer links, so the conversation drives the colour engine.
 * There are deliberately no [data-zone] sections here, so the scroll engine never overrides it.
 */
import Base from '../layouts/Base.astro'
import { about, siteMeta, venturesBySlug } from '../lib/content'
import { PAGE_KEYWORDS } from '../lib/seo'
import '../styles/chat.css'

const suggestions: { q: string; work: string }[] = [
  { q: 'What does Alden do?', work: 'house' },
  { q: 'What is Rotavox, and how did he build it?', work: 'rotavox' },
  { q: 'How does Memrey find a photo?', work: 'memrey' },
  { q: 'Tell me about The Bolt.', work: 'bolt' },
  { q: 'Show me his film work.', work: 'shadowcat' },
  { q: 'Is he open to new roles?', work: 'house' },
].filter((s) => s.work === 'house' || venturesBySlug[s.work])

// The About intro is written in the first person; the chat speaks about Alden in the third.
const lead = (about.intro ?? '').replace(/^I[’']m a/, 'Alden is a')

const browse = siteMeta.nav.filter((n) => n.href !== '/')
---

<Base
  title="Alden Gillespy — Software Engineer & Video Producer"
  description="Ask anything about Alden Gillespy — the products he builds and runs, the films he shoots, his experience and how to work with him. Answers link straight to the case studies, films and writing."
  keywords={PAGE_KEYWORDS.home}
  ogKey="home"
  zone="neutral"
  work="house"
  bare
>
  <section class="chat" id="chat">
    <div class="chat__col">
      <header class="chat__intro">
        <span class="mono">Salt Lake City · Engineer &amp; filmmaker</span>
        <h1>Ask me about Alden.</h1>
        <p class="chat__lead">{lead}</p>
        <ul class="chat__suggest" aria-label="Suggested questions">
          {
            suggestions.map((s) => (
              <li>
                <button type="button" class="suggest" data-ask={s.q} data-work={s.work}>
                  {s.q}
                </button>
              </li>
            ))
          }
        </ul>
      </header>

      <div id="chat-log" class="chat__log ph-no-capture" role="log" aria-live="polite" aria-label="Conversation"></div>

      <nav class="chat__browse" aria-label="Browse the site">
        <span class="mono">Or browse</span>
        {browse.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href="/contact" data-contact-open>Contact</a>
      </nav>
    </div>

    <form class="composer" id="chat-form" autocomplete="off">
      <div class="composer__in">
        <label class="sr" for="chat-input">Ask about Alden</label>
        <textarea
          id="chat-input"
          class="ph-no-capture"
          rows="1"
          maxlength="1500"
          placeholder="Ask about his work, experience, films…"
          enterkeyhint="send"></textarea>
        <button id="chat-send" class="composer__send" type="submit" aria-label="Send" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
      <p class="composer__note">
        <span>AI guide · answers only from this site · can make mistakes</span>
        <button type="button" id="chat-reset" class="composer__reset">New chat</button>
      </p>
    </form>

    <noscript>
      <p class="chat__nojs">The chat needs JavaScript. Everything it knows is on the pages above.</p>
    </noscript>
  </section>

  <script>
    import { initChat } from '../scripts/chat.ts'
    try {
      initChat()
    } catch (e) {
      console.error(e)
    }
  </script>
</Base>
