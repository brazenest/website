---
/**
 * BLOG POST — /blog/posts/<slug>. One page per published post in the posts collection;
 * inherits the related venture's colour via data-work="{venture.slug}". Renders the post
 * title, date, category, read time, excerpt and richText body in a clean reading style.
 * The contact CTA at the bottom is house/neutral.
 */
import Base from '../../../layouts/Base.astro'
import CoverArt from '../../../components/CoverArt.astro'
import { posts, postHref, venturesBySlug, siteMeta, isExternalHref, categoryLabel, coverFor } from '../../../lib/content'
import { renderRichText } from '../../../lib/richText'
import { absoluteUrl, blogPostingSchema, breadcrumbSchema, ogImageFor, postKeywords } from '../../../lib/seo'

export function getStaticPaths() {
  return posts.map((p) => ({
    params: { slug: p.slug },
    props: { post: p },
  }))
}

const { post } = Astro.props
const venture = post.relatedVenture ? venturesBySlug[post.relatedVenture as string] : venturesBySlug.house
const published = post.publishedAt ? new Date(post.publishedAt) : null

const url = absoluteUrl(postHref(post.slug))
const cover = coverFor(post)
const ogKey = `post-${post.slug}`
const keywords = postKeywords(post)
// The author's own metaDescription wins; the excerpt is the natural fallback since it is
// already written as a summary.
const description = post.seo?.metaDescription || post.excerpt || undefined
const schema = [
  blogPostingSchema(post, url, ogImageFor(ogKey), keywords),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: post.title, path: postHref(post.slug) },
  ]),
]
---

<Base
  title={post.seo?.metaTitle || post.title}
  description={description}
  keywords={keywords}
  ogKey={ogKey}
  ogType="article"
  article={{
    publishedTime: post.publishedAt,
    // No modifiedTime: Payload's updatedAt is a database timestamp, not a revision date —
    // see modifiedDate() in lib/seo.ts for why publishing it would be actively misleading.
    section: post.category ? categoryLabel(post.category) : null,
  }}
  schema={schema}
  zone="neutral"
  work={venture.slug}
>
  <section class="z-neutral" data-zone="neutral" data-work={venture.slug}>
    <div class="col">
      <div class="crumb"><a href="/blog">Blog</a><span>/</span><span class="on">{post.title}</span></div>
      <article class="post">
        {/* A category default is shared by every post in that category, so it carries no
            information about THIS post — mark it decorative. A cover uploaded for the post
            itself is content, and keeps its own alt text. */}
        <CoverArt
          image={cover.image}
          palette={cover.palette}
          seed={cover.seed}
          alt={cover.source === 'post' ? cover.image?.alt || post.title : ''}
          sizes="(max-width:1280px) 100vw, 1200px"
          loading="eager"
          class="post__hero"
        />
        <header class="post__header">
          <h1 class="halo">{post.title}</h1>
          <div class="post__meta">
            {published && <time datetime={published.toISOString()}>{published.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>}
            {post.category && <><span aria-hidden="true">·</span><span>{categoryLabel(post.category)}</span></>}
            {post.readTime && <><span aria-hidden="true">·</span><span>{post.readTime} min read</span></>}
          </div>
          {post.excerpt && <p class="post__excerpt">{post.excerpt}</p>}
        </header>
        <div class="post__body prose" set:html={renderRichText(post.body)} />
      </article>

      <div class="nextup">
        <div><span class="mono">Back to</span><h4>Blog</h4></div>
        <a class="go" href="/blog">Read more <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="contact z-neutral" data-zone="neutral" data-work="house">
    <div class="col">
      <h3>Got a response?</h3>
      <p>Find me at the email below or on the socials — I read everything.</p>
      <div class="contact__row">
        <a class="big" href="/contact" data-contact-open>Start a conversation <span>→</span></a>
        {siteMeta.social.map((s) => <a class="alt" href={s.url} target={isExternalHref(s.url) ? '_blank' : undefined} rel={isExternalHref(s.url) ? 'noopener noreferrer' : undefined}>{s.label}</a>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .post {
    margin-block: clamp(30px, 3.4vw, 56px);
  }
  /* :global is LOAD-BEARING. Astro appends its scope to the LAST compound in a selector, so
     a plain `.post__hero` compiles to `.post__hero[data-astro-cid-…]` — and this class lands
     on the <figure> that CoverArt.astro renders, which never receives this page's scope
     attribute. Without :global the rule silently matches nothing and the hero sits flush
     against the H1. Same trap as .prose on the case-study page: styles aimed at markup this
     file doesn't literally contain have to be global. */
  :global(.post__hero) {
    margin-bottom: clamp(26px, 3vw, 48px);
    /* The cover is a band above the headline, not the subject of the page. At the column's
       full width the shared 1200/630 comes out ~615px tall, which put the H1 at or below the
       fold on a laptop — the one thing a reader opening a post needs to see first.
       Re-proportioned rather than capped: a max-height fights the inherited aspect-ratio and
       the ratio wins, collapsing the width to 640px instead of cropping. Overriding the ratio
       keeps the box full-width, and .cover already crops (overflow:hidden + object-fit:cover,
       and preserveAspectRatio="slice" on the generated SVG) so a photograph and the generated
       art both lose their edges rather than distorting. */
    aspect-ratio: 16 / 5;
  }
  /* A 3.2:1 band is 107px tall on a phone — a sliver rather than an image. Narrow screens
     have the vertical room to spare (the headline still lands well above the fold), so the
     cover goes back to something with presence. */
  @media (max-width: 640px) {
    :global(.post__hero) {
      aspect-ratio: 16 / 9;
    }
  }
  .post__header {
    margin-bottom: clamp(30px, 3.4vw, 56px);
  }
  .post__header h1 {
    margin-bottom: clamp(20px, 2vw, 32px);
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--f-m);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .post__excerpt {
    margin-top: clamp(20px, 2vw, 32px);
    max-width: 62ch;
    font-size: clamp(17px, 1.35vw, 21px);
    line-height: 1.5;
    color: var(--muted);
  }
  .post__body {
    max-width: 70ch;
  }
</style>
