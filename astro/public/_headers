# Cloudflare Pages headers. Static hashed assets + self-hosted fonts are content-stable,
# so cache them hard; everything gets a few conservative security headers (no CSP — the
# site uses inline scripts/styles and the Turnstile widget, and a wrong CSP breaks them).

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Social cards (v6.2). The URL is deliberately stable — no content hash — because social
# platforms cache and re-scrape by URL. That makes them mutable content at a fixed address,
# so they must NOT be immutable: a day, then revalidate, or an updated cover image would be
# stuck in caches for a year.
/og/*
  Cache-Control: public, max-age=86400, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
